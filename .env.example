# Copy to apps/web/.env.local for local overrides. Never commit real secrets.
# Only variables prefixed with VITE_ are exposed to browser code — never put secrets in them.

# Multiplayer is off until the single-player vertical slice is stable (see docs/GDD/vision.md).
VITE_MULTIPLAYER_ENABLED=false

# Game server endpoint used once multiplayer exists. Local dev, LAN (ws://192.168.x.x:2567)
# and online (wss://...) all use the same client — only this value changes.
VITE_SERVER_URL=ws://localhost:2567

# Optional locale override: en or th. URL ?lang=th takes precedence for QA and sharing.
# VITE_LOCALE=th
